      "localizations" : {
        "fr" : {
          "stringUnit" : { "state" : "translated", "value" : "Fait" }
        }
      }
    },
    "Full read and write access to calendar events." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lecture et écriture complètes sur les événements du calendrier."
          }
        }
      }
    },
    "Grant…" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : { "state" : "translated", "value" : "Autoriser…" }
        }
      }
    },
    "Helper" : {
      "comment" : "The background service that holds the calendar permission",
      "localizations" : {
        "fr" : {
          "stringUnit" : { "state" : "translated", "value" : "Service d’arrière-plan" }
        }
      }
    },
    "Install" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : { "state" : "translated", "value" : "Installer" }
        }
      }
    },
    "Information" : {
      "comment" : "VoiceOver label for a setup line that only informs",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Information"
          }
        }
      }
    },
    "Calendar access" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : { "state" : "translated", "value" : "Accès au calendrier" }
        }
      }
    },
    "Claude Desktop only. This is built into this version; any other client is refused." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude Desktop uniquement. C’est intégré à cette version ; tout autre client est refusé."
          }
        }
      }
    },
    "Not granted yet." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : { "state" : "translated", "value" : "Pas encore accordé." }
        }
      }
    },
    "Not installed." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : { "state" : "translated", "value" : "Pas installé." }
        }
      }
    },
    "Not done yet" : {
      "comment" : "VoiceOver label for a setup step still to do",
      "localizations" : {
        "fr" : {
          "stringUnit" : { "state" : "translated", "value" : "Pas encore fait" }
        }
      }
    },
    "Only event creation is allowed. Reading events needs full access." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seule la création d’événements est autorisée. Les lire exige un accès complet."
          }
        }
      }
    },
    "Refused. Grant it in System Settings › Privacy & Security › Calendars." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Refusé. Autorisez-le dans Réglages › Confidentialité et sécurité › Calendriers."
          }
        }
      }
    },
    "Remove" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : { "state" : "translated", "value" : "Retirer" }
        }
      }
    },
    "Runs in the background and holds the calendar permission." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tourne en arrière-plan et détient l’autorisation calendrier."
          }
        }
      }
    },
    "The system reported a status this version does not recognise." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le système a renvoyé un état inconnu de cette version."
          }
        }
      }
    },
    "Then restart the client." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : { "state" : "translated", "value" : "Redémarrez ensuite le client." }
        }
      }
    },
    "Two things have to be true before an assistant can reach your calendar." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deux conditions doivent être réunies pour qu’un assistant atteigne votre calendrier."
          }
        }
      }
    },
    "Waiting for your approval in System Settings › General › Login Items." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En attente de votre accord dans Réglages › Général › Ouverture et extensions."
          }
        }
      }
    }
