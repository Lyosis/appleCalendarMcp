<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.wilfrid.B.apple-calendar-mcp.agent</string>
	<!-- Path relative to the containing app bundle, per SMAppService. -->
	<key>BundleProgram</key>
	<string>Contents/MacOS/apple-calendar-mcp</string>
	<!-- launchd refuses the job with EX_CONFIG when this is absent, even though
	     BundleProgram already names the executable. Measured, not guessed. -->
	<key>ProgramArguments</key>
	<array>
		<string>apple-calendar-mcp</string>
	</array>
	<!-- Advertised on demand: launchd starts the helper on the first message
	     and not before, so it is not running while nobody is using it.
	     Must stay identical to machServiceName in Sources/AppleCalendarIPC. -->
	<key>MachServices</key>
	<dict>
		<key>com.wilfrid.B.apple-calendar-mcp.agent</key>
		<true/>
	</dict>
</dict>
</plist>
