<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleIdentifier</key>
	<string>com.wilfrid.B.apple-calendar-mcp</string>
	<key>CFBundleName</key>
	<string>apple-calendar-mcp</string>
	<key>CFBundleExecutable</key>
	<string>AppleCalendarMCP</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<!-- Kept in step with serverVersion by --selftest, which fails on drift. -->
	<key>CFBundleShortVersionString</key>
	<string>0.1.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>LSMinimumSystemVersion</key>
	<string>14.4</string>
	<!-- Deliberately neither LSBackgroundOnly nor LSUIElement: the bundle's main
	     executable is the setup window, and it must be able to show itself and
	     to present the system permission prompt. The launch agent is a separate
	     executable started by launchd, so it gets no dock icon regardless. -->
	<key>NSCalendarsFullAccessUsageDescription</key>
	<string>apple-calendar-mcp lets Claude read your calendars and create, edit or delete events on your behalf.</string>
</dict>
</plist>
